# Salin jadi .env lalu isi. Nilainya ada di Supabase Dashboard → Project Settings → API.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Untuk fitur "Tanya AI" kalori makanan. Buat di https://platform.claude.com → API Keys.
ANTHROPIC_API_KEY=sk-ant-...
# Opsional: ganti model (default claude-opus-5-5). claude-haiku-5-5 jauh lebih murah.
# ANTHROPIC_MODEL=claude-opus-5-5

# Hanya untuk script lokal (seed & import). JANGAN dipasang di Vercel, JANGAN di-commit.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Zona waktu untuk menentukan "tanggal" (WIB = +07:00, WITA = +08:00, WIT = +09:00)
APP_TZ_OFFSET=+07:00

PORT=3000
